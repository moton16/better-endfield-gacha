{
  "name": "better-endfield-gacha",
  "version": "0.1.0-dev",
  "description": "终末地抽卡链接提取与抽卡记录管理/分析工具（B 服 / 官服 / 国际服）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "beg": "dist/cli/index.js"
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "web:dev": "vite --config vite.config.ts",
    "web:build": "vite build --config vite.config.ts",
    "test": "vitest run",
    "pack": "pwsh -NoProfile -File scripts/pack.ps1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.0.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.6",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "dependencies": {
    "preact": "^10.29.8"
  }
}
