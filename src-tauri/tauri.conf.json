{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Better Endfield Gacha",
  "version": "0.1.0",
  "identifier": "io.github.better-endfield-gacha",
  "app": {
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Better Endfield Gacha",
        "url": "about:blank",
        "width": 496,
        "height": 900,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["resources/**/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
