{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": [
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/core/analysis/types.ts",
    "src/core/analysis/common.ts",
    "src/core/analysis/config.ts",
    "tests/web*.test.tsx"
  ]
}
